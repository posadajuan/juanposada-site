---
/**
 * One route for everything under /work/…:
 * every public case study and every gallery (logos, graphic pieces).
 * Adding a folder in src/content creates its page automatically.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudy from '@/components/CaseStudy.astro';
import GalleryPage from '@/components/GalleryPage.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { ctas } from '@/data/pages';
import { PERSON_ID } from '@/lib/seo';
import { site } from '@/data/site';
import { getGalleries, getPublicProjects, nextProject, type Gallery, type Project } from '@/lib/content';

export const getStaticPaths = (async () => {
  const projects = await getPublicProjects();
  const galleries = await getGalleries();

  const slugs = new Set<string>();
  const claim = (slug: string) => {
    if (slugs.has(slug)) {
      throw new Error(`Two items use the folder name "${slug}". Rename one of them in src/content.`);
    }
    slugs.add(slug);
  };

  return [
    ...projects.map((project) => {
      claim(project.id);
      return {
        params: { slug: project.id },
        props: { kind: 'project' as const, project, next: nextProject(projects, project) },
      };
    }),
    ...galleries.map((gallery, i) => {
      claim(gallery.id);
      const next = galleries.length > 1 ? galleries[(i + 1) % galleries.length] : undefined;
      return {
        params: { slug: gallery.id },
        props: { kind: 'gallery' as const, gallery, next },
      };
    }),
  ];
}) satisfies GetStaticPaths;

type Props =
  | { kind: 'project'; project: Project; next?: Project }
  | { kind: 'gallery'; gallery: Gallery; next?: Gallery };

const props = Astro.props as Props;

const meta =
  props.kind === 'project'
    ? {
        // e.g. "Cyber Explorers — UI & UX case study": says what the page is in search results.
        title: props.project.data.metaTitle ?? `${props.project.data.title} — ${props.project.data.tags[0]} case study`,
        description: props.project.data.outcome,
        image: props.project.data.cover,
        imageAlt: props.project.data.coverAlt,
      }
    : {
        title: props.gallery.data.title,
        description: `${props.gallery.data.summary}, by ${site.name}, ${site.role.toLowerCase()} in London.`,
        image: props.gallery.data.cover,
        imageAlt: props.gallery.data.coverAlt,
      };

// Structured data so search engines and AI assistants know what this work is and who made it.
const pageUrl = new URL(`/work/${props.kind === 'project' ? props.project.id : props.gallery.id}/`, Astro.site).href;
const schema: Record<string, unknown>[] = [
  props.kind === 'project'
    ? {
        '@type': 'CreativeWork',
        '@id': `${pageUrl}#work`,
        name: props.project.data.title,
        headline: props.project.data.title,
        description: props.project.data.outcome,
        url: pageUrl,
        dateCreated: String(props.project.data.year),
        keywords: props.project.data.tags.join(', '),
        creator: { '@id': PERSON_ID },
        inLanguage: 'en-GB',
      }
    : {
        '@type': 'CollectionPage',
        name: props.gallery.data.title,
        description: props.gallery.data.summary,
        url: pageUrl,
        author: { '@id': PERSON_ID },
      },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: new URL('/work/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: meta.title, item: pageUrl },
    ],
  },
];

// End each page with a call to action that fits what the visitor just saw.
const cta = (() => {
  if (props.kind === 'gallery') return props.gallery.data.kind === 'logos' ? ctas.logos : ctas.graphicDesign;
  const tags = props.project.data.tags;
  if (tags.includes('Digital learning')) return ctas.learning;
  if (tags.includes('Character design')) return ctas.characters;
  return ctas.brand;
})();
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={meta.image}
  imageAlt={meta.imageAlt}
  type={props.kind === 'project' ? 'article' : 'website'}
  schema={schema}
>
  {
    props.kind === 'project' ? (
      <CaseStudy project={props.project} next={props.next} />
    ) : (
      <GalleryPage gallery={props.gallery} next={props.next} />
    )
  }
  <CtaBlock {...cta} />
</BaseLayout>
