---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import GalleryCard from '@/components/GalleryCard.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { getProjects, getGalleries, getDesignProjects } from '@/lib/content';
import { work, ctas } from '@/data/pages';

const projects = await getProjects();
const galleries = await getGalleries();
const designProjects = await getDesignProjects();
const count = (n: number) => String(n).padStart(2, '0');

const eyebrowParts = [`${count(projects.length)} case ${projects.length === 1 ? 'study' : 'studies'}`];
const collections = galleries.length + (designProjects.length ? 1 : 0);
if (collections) eyebrowParts.push(`${collections} ${collections === 1 ? 'collection' : 'collections'}`);
---

<BaseLayout
  title="Work"
  description="Case studies and graphic design by Juan Posada: UX/UI, digital learning, branding and print."
>
  <section class="container page-intro" data-reveal="stagger">
    <p class="label muted">Work · {eyebrowParts.join(' · ')}</p>
    <h1 class="page-title">Selected <span class="gradient-text">work</span></h1>
    <p class="lead">{work.intro}</p>
  </section>

  <section class="container section block" aria-labelledby="case-studies">
    <div class="block__head">
      <SectionHeader id="case-studies" title="Case studies" size="m" />
      <span class="label muted">{count(projects.length)}</span>
    </div>
    <div class="grid-2">
      {projects.map((project, i) => <ProjectCard project={project} showYear priority={i < 2} />)}
    </div>
  </section>

  {
    collections > 0 && (
      <section class="container section block" aria-labelledby="more-work">
        <div class="block__head">
          <SectionHeader id="more-work" title="More work" size="m" />
          <span class="label muted">Collections</span>
        </div>
        <div class="galleries">
          {galleries.map((gallery) => (
            <GalleryCard gallery={gallery} icon={gallery.data.kind === 'logos' ? 'logos' : undefined} />
          ))}
          {designProjects.length > 0 && (
            <GalleryCard
              href="/work/graphic-design"
              title="Graphic design"
              summary={`${designProjects.length} identity, packaging and print projects`}
              icon="design"
            />
          )}
        </div>
      </section>
    )
  }

  <CtaBlock {...ctas.work} />
</BaseLayout>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }

  .galleries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 760px) {
    .galleries {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
