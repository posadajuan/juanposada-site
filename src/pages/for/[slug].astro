---
/**
 * /for/<company>: a short, private page made for one job application.
 * One folder in src/content/for creates one page. These pages are
 * kept out of the menu, the sitemap and search engines (noindex).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import Logo from '@/components/Logo.astro';
import { getPublicProjects } from '@/lib/content';
import { site } from '@/data/site';

export const getStaticPaths = (async () => {
  const pages = await getCollection('applications', ({ data }) => import.meta.env.DEV || !data.draft);
  const projects = await getPublicProjects();
  return pages.map((page) => {
    const picked = page.data.projects.map((id) => {
      const found = projects.find((p) => p.id === id);
      if (!found) throw new Error(`src/content/for/${page.id}: no public case study called "${id}".`);
      return found;
    });
    return { params: { slug: page.id }, props: { page, picked } };
  });
}) satisfies GetStaticPaths;

interface Props {
  page: CollectionEntry<'applications'>;
  picked: Awaited<ReturnType<typeof getPublicProjects>>;
}

const { page, picked } = Astro.props;
const d = page.data;
const linkedin = site.socials.find((s) => s.label === 'LinkedIn')?.href;
---

<BaseLayout title={`For ${d.company}`} description={`${site.name} — ${d.role} at ${d.company}`} noindex>
  <section class="container for-hero" aria-labelledby="for-title">
    <div class="for-hero__meta" data-reveal>
      <span class="for-chip"><Logo size={16} /> × {d.company}</span>
      <span class="label muted">{d.role}</span>
    </div>
    <h1 id="for-title" class="hero-title for-hero__title" data-reveal>
      {d.hero.before} <span class="gradient-text">{d.hero.highlight}</span> {d.hero.after}
    </h1>
    <p class="lead" data-reveal>{d.intro}</p>
    <div class="for-hero__actions" data-reveal>
      {
        d.cv && (
          <a class="btn btn--primary" href={d.cv} download>
            Download my CV <span class="arrow" aria-hidden="true">↓</span>
          </a>
        )
      }
      <a class="btn btn--secondary" href="#contact">Get in touch</a>
    </div>
  </section>

  <section class="container section" aria-labelledby="fit-title">
    <SectionHeader id="fit-title" eyebrow="Why me" title={`What ${d.company} needs, and what I bring`} />
    <ol class="fit">
      {
        d.fit.map((f, i) => (
          <li class="fit__row" data-reveal>
            <span class="fit__n label muted">{String(i + 1).padStart(2, '0')}</span>
            <p class="fit__need display">{f.need}</p>
            <p class="fit__proof">{f.proof}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    picked.length > 0 && (
      <section class="container section" aria-labelledby="work-title">
        <SectionHeader id="work-title" eyebrow="Relevant work" title="Work that speaks to this role" />
        <div class="grid-2 for-work">
          {picked.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  {
    d.plan.length > 0 && (
      <section class="container section" aria-labelledby="plan-title">
        <SectionHeader id="plan-title" eyebrow="How I'd start" title="My first 90 days" />
        <ol class="plan">
          {d.plan.map((step) => (
            <li class="plan__step" data-reveal>
              <span class="label">{step.when}</span>
              <p>{step.what}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="container cta-wrap" id="contact" aria-labelledby="for-cta">
    <div class="for-cta" data-theme="dark" data-reveal>
      <h2 id="for-cta" class="for-cta__title display">
        {d.closing ?? `I'd love to talk about ${d.role} at`} <span class="gradient-text">{d.closing ? '' : `${d.company}.`}</span>
      </h2>
      <div class="for-hero__actions">
        <CopyEmailButton />
        {
          linkedin && (
            <a class="btn btn--secondary" href={linkedin} rel="noopener" target="_blank">
              LinkedIn
            </a>
          )
        }
        {
          d.cv && (
            <a class="btn btn--secondary" href={d.cv} download>
              CV (PDF)
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .for-hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(56px, 3rem + 4vw, 112px) clamp(56px, 2rem + 4vw, 104px);
  }
  .for-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .for-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }
  .for-hero__title {
    max-width: 20ch;
  }
  .for-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .fit {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .fit__row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px 40px;
    padding-block: 32px;
    border-bottom: 1px solid var(--color-border);
  }
  .fit__need {
    font-size: var(--text-h3);
    color: var(--color-text);
  }
  .fit__proof {
    color: var(--color-body);
  }
  @media (max-width: 760px) {
    .fit__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
  .for-work {
    margin-top: var(--space-xl);
  }
  .plan {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .plan__step {
    background: var(--color-surface);
    border-radius: var(--radius-l);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 760px) {
    .plan {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cta-wrap {
    padding-block-end: var(--space-section);
  }
  .for-cta {
    background: var(--color-cta-bg);
    color: var(--color-text);
    border-radius: var(--radius-xl);
    padding: clamp(40px, 2rem + 4vw, 96px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .for-cta__title {
    font-size: var(--text-h1);
    max-width: 22ch;
  }
</style>
