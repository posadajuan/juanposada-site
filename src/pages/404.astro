---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container nf">
    <p class="label muted">Error 404</p>
    <h1 class="page-title">This page took a <span class="gradient-text">detour.</span></h1>
    <p class="lead">The link may be old or mistyped. Here are some good places to go instead.</p>
    <div class="nf__actions">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/work" class="btn btn--secondary">See my work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(96px, 4rem + 8vw, 176px);
    min-height: 70vh;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
