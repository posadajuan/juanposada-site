---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { site } from '@/data/site';
---

<BaseLayout>
  <section class="container hero">
    {
      site.availability.show && (
        <p class="status">
          <span class="status__dot" aria-hidden="true" />
          {site.availability.text}
        </p>
      )
    }
    <h1 class="hero-title">
      Juan Posada — I turn complex ideas into <span class="gradient-text">clear, playful</span> digital
      experiences, from first sketch to launch.
    </h1>
    <div class="hero__actions">
      <a href="/work" class="btn btn--primary">See my work <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/contact" class="btn btn--secondary">Get in touch</a>
    </div>
  </section>

  <section class="container section">
    <div class="media-placeholder hero__media">
      <span class="label">Showreel · coming in step 6.4</span>
    </div>
  </section>

  <CtaBlock />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: clamp(72px, 3rem + 6vw, 128px) 72px;
  }

  .hero-title {
    max-width: 22ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__media {
    height: clamp(280px, 40vw, 560px);
  }
</style>
