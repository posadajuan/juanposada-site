---
/**
 * One line of client logos drifting right to left, in a loop.
 *
 * Logos come from src/data/clients.ts and are drawn in one ink
 * (the text colour), so they suit both themes. Each logo is sized by its
 * shape so they look equally weighted: same area, within a min/max height.
 *
 * It slows down on hover, pauses when off screen, and for visitors who
 * prefer less motion it becomes a still, centred, wrapping row.
 */
import { clients } from '@/data/clients';

// Equal visual weight: height = √(area ÷ ratio), kept between 22px and 42px.
const AREA = 4200;
const sized = clients.map((c) => {
  const h = Math.min(42, Math.max(22, Math.sqrt(AREA / c.ratio)));
  return { ...c, h: Math.round(h), w: Math.round(h * c.ratio) };
});
---

<section class="marquee" data-marquee aria-label="Brands I've worked with">
  <p class="marquee__label label muted">Brands I’ve worked with</p>
  <div class="marquee__viewport">
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {sized.map((c) => (
              <li class="marquee__item">
                <span
                  class="marquee__logo"
                  role="img"
                  aria-label={copy === 0 ? c.name : undefined}
                  style={`--logo: url('${c.file}'); --w: ${c.w}px; --h: ${c.h}px`}
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initMarquee() {
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
      if (el.dataset.marqueeReady) return;
      el.dataset.marqueeReady = '1';
      new IntersectionObserver(([entry]) => el.toggleAttribute('data-play', !!entry?.isIntersecting)).observe(el);
      const setRate = (rate: number) => el.getAnimations({ subtree: true }).forEach((a) => (a.playbackRate = rate));
      el.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && setRate(0.3));
      el.addEventListener('pointerleave', () => setRate(1));
    });
  }
  document.addEventListener('astro:page-load', initMarquee);
</script>

<style>
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 40px;
    border-block: 1px solid var(--color-border);
  }

  .marquee__label {
    text-align: center;
  }

  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__list {
    display: flex;
    align-items: center;
    gap: clamp(48px, 5vw, 80px);
    margin: 0;
    padding: 0 clamp(24px, 2.5vw, 40px);
    list-style: none;
  }

  .marquee__item {
    display: flex;
    flex: none;
  }

  /* One ink: the logo file is a mask, the text colour fills it */
  .marquee__logo {
    --s: 1;
    display: block;
    width: calc(var(--w) * var(--s));
    height: calc(var(--h) * var(--s));
    background-color: currentColor;
    opacity: 0.72;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transition: opacity var(--dur-fast) ease;
  }

  .marquee__item:hover .marquee__logo {
    opacity: 1;
  }

  /* Moving, only for visitors who haven't asked for less motion */
  :global([data-motion]) .marquee__track {
    animation: marquee-drift 60s linear infinite;
  }

  .marquee:not([data-play]) .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Less motion: a still, centred block of logos (second copy hidden) */
  :global(html:not([data-motion])) .marquee__viewport {
    -webkit-mask-image: none;
    mask-image: none;
  }
  :global(html:not([data-motion])) .marquee__track {
    width: auto;
  }
  :global(html:not([data-motion])) .marquee__list {
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 32px;
  }
  :global(html:not([data-motion])) .marquee__list[aria-hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .marquee {
      padding-block: 32px;
      gap: 22px;
    }
    .marquee__list {
      gap: 40px;
      padding-inline: 20px;
    }
    .marquee__logo {
      --s: 0.72;
    }
  }
</style>
