---
/**
 * Small icons for the "How I work" steps, in the same style as the
 * More work icons: bold rounded strokes with a slice of neon gradient.
 * Light mode: solid black.
 */
interface Props {
  name: 'understand' | 'concept' | 'design' | 'launch';
}
const { name } = Astro.props;

const icons = {
  understand: { stops: ['#ffe900', '#00ffe8'], paths: ['M38 14a22 22 0 1 1 0 44a22 22 0 1 1 0-44Z', 'M54 54L72 72'] },
  concept: { stops: ['#00ffe8', '#00a8ff'], paths: ['M42 10a22 22 0 0 0-13 39.7V60h26V49.7A22 22 0 0 0 42 10Z', 'M32 72h20'] },
  design: { stops: ['#00fdff', '#7500ff'], paths: ['M16 12h30a6 6 0 0 1 6 6v24a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6V18a6 6 0 0 1 6-6Z', 'M38 36h30a6 6 0 0 1 6 6v24a6 6 0 0 1-6 6H38a6 6 0 0 1-6-6V54'] },
  launch: { stops: ['#7500ff', '#ff00ff'], paths: ['M34 14H18a6 6 0 0 0-6 6v46a6 6 0 0 0 6 6h46a6 6 0 0 0 6-6V50', 'M42 42L72 12', 'M52 12h20v20'] },
} as const;
const icon = icons[name];
const id = `si-${name}`;
---

<span class="sicon" aria-hidden="true">
  <svg viewBox="0 0 84 84" fill="none">
    <defs>
      <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="8" y1="8" x2="76" y2="76">
        <stop offset="0" stop-color={icon.stops[0]} />
        <stop offset="1" stop-color={icon.stops[1]} />
      </linearGradient>
    </defs>
    <g class="sicon__stroke" style={`--g: url(#${id})`} stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
      {icon.paths.map((d) => <path d={d} />)}
    </g>
  </svg>
</span>

<style>
  .sicon {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-m);
    border: 1px solid var(--color-border);
    background:
      radial-gradient(120% 90% at 70% 20%, color-mix(in srgb, var(--neon-cyan) 8%, transparent), transparent 60%),
      var(--color-media);
  }

  .sicon svg {
    width: 34px;
    height: 34px;
  }

  .sicon__stroke {
    stroke: var(--g);
  }

  :global(html[data-theme='light']) .sicon__stroke {
    stroke: #0a0a0a;
  }
</style>
