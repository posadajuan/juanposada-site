---
/**
 * The quiet, interactive background behind the Home headline. It lives
 * only in the empty top-right of the hero and fades out towards the text.
 *
 * - A field of fine dots that sways slowly, like particles in still water.
 * - A soft, slightly warm light follows the cursor. Its strength depends on
 *   where it is: full in the top-right, dimming gradually as the cursor
 *   moves away, so it never cuts off.
 * - Moving through the dots stirs them like plankton: they drift with the
 *   motion, light up in cyan and blue with a soft halo, then settle and
 *   fade back over a second or two. Resting the cursor stirs nothing.
 *
 * Kept light: the canvas only covers the right of the hero, resting dots
 * are drawn in a few batches, the light is pre-rendered once, the idle
 * drift runs at a third of the frame rate, and it pauses off screen or in
 * a background tab. Visitors who prefer less motion get a still field.
 */
---

<div class="field" data-field aria-hidden="true">
  <canvas class="field__canvas"></canvas>
</div>

<script>
  const TAU = Math.PI * 2;
  const INK_DARK = [238, 234, 226]; // resting dots: a soft, warm off-white
  const INK_LIGHT = [24, 24, 24];
  // Bioluminescence: from cyan-green through cyan to electric blue.
  const GLOW_A = [40, 255, 210];
  const GLOW_B = [0, 220, 255];
  const GLOW_C = [70, 130, 255];
  const GLOW_A_LIGHT = [0, 150, 140];
  const GLOW_C_LIGHT = [30, 90, 210];
  const BUCKETS = 12;
  const MAX_ALPHA = 0.9;
  const LIGHT_PEAK = 0.1;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i]! - v) * t));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  /** The warm light, drawn once and reused every frame. */
  function makeLight() {
    const size = 512;
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d')!;
    const r = size / 2;
    const grad = g.createRadialGradient(r, r, 0, r, r, r);
    grad.addColorStop(0, `rgba(255, 244, 228, ${LIGHT_PEAK})`);
    grad.addColorStop(0.35, `rgba(255, 238, 215, ${LIGHT_PEAK * 0.45})`);
    grad.addColorStop(0.7, `rgba(255, 232, 205, ${LIGHT_PEAK * 0.12})`);
    grad.addColorStop(1, 'rgba(255, 230, 200, 0)');
    g.fillStyle = grad;
    g.fillRect(0, 0, size, size);
    return c;
  }

  let teardown: (() => void) | null = null;

  function initField() {
    teardown?.();
    const root = document.querySelector<HTMLElement>('[data-field]');
    const canvas = root?.querySelector('canvas');
    const ctx = canvas?.getContext('2d');
    if (!root || !canvas || !ctx) return;

    const html = document.documentElement;
    const still = !html.hasAttribute('data-motion');
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const lightImg = makeLight();

    let W = 0;
    let H = 0;
    let narrow = false;
    let light = html.dataset.theme === 'light';
    let raf = 0;
    let running = false;
    let onScreen = true;
    let frameNo = 0;
    let last = performance.now();
    const start = last;

    // Dot state, in flat arrays: home position, presence (how visible the
    // dot is at rest), wave phase, drift offset and velocity, glow level,
    // and a per-dot colour tint so the glow feels organic.
    let n = 0;
    let bx = new Float32Array(0);
    let by = new Float32Array(0);
    let pres = new Float32Array(0);
    let phase = new Float32Array(0);
    let ox = new Float32Array(0);
    let oy = new Float32Array(0);
    let vx = new Float32Array(0);
    let vy = new Float32Array(0);
    let glow = new Float32Array(0);
    let tint = new Float32Array(0);
    let sens = new Float32Array(0);
    // Each dot's glow colours, worked out once per layout and theme.
    let halo: string[] = [];
    let core: string[] = [];

    // The cursor light: drawn position, target, how strongly it shows
    // (fades with distance from the top-right), and whether a real mouse
    // is over the hero.
    const p = { x: 0, y: 0, tx: 0, ty: 0, level: 0, lastMove: -1e9, inside: false, placed: false };

    // Where the field lives, as fractions of the canvas.
    // Wide screens: the canvas covers the right two-thirds of the hero.
    // Phones: the whole hero, tucked into the top-right corner above the text.
    const shape = () =>
      narrow
        ? { fx: 0.94, fy: 0.02, rx: 0.62, ry: 0.3, wx: 0.82, wy: 0.06, ax: 0.1, ay: 0.04 }
        : { fx: 0.7, fy: 0.3, rx: 0.68, ry: 0.75, wx: 0.64, wy: 0.3, ax: 0.18, ay: 0.16 };

    function focus(x: number, y: number) {
      const s = shape();
      const d = Math.hypot((x - W * s.fx) / (W * s.rx), (y - H * s.fy) / (H * s.ry));
      return clamp(1 - d) ** 1.35;
    }

    function layout() {
      const rect = root!.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      narrow = window.innerWidth < 760;
      const dpr = Math.min(1.5, window.devicePixelRatio || 1);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const gap = narrow ? 24 : 22;
      const cols = Math.ceil(W / gap) + 1;
      const rows = Math.ceil(H / gap) + 1;
      const xs: number[] = [];
      const ys: number[] = [];
      const ws: number[] = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * gap + (r % 2 ? gap / 2 : 0);
          const y = r * gap;
          const w = focus(x, y);
          if (w <= 0.001) continue; // never visible: skip it entirely
          xs.push(x);
          ys.push(y);
          ws.push(w);
        }
      }
      n = xs.length;
      bx = Float32Array.from(xs);
      by = Float32Array.from(ys);
      pres = Float32Array.from(ws);
      phase = Float32Array.from(xs.map((x, i) => (x * 0.011 + ys[i]! * 0.017) % TAU));
      tint = Float32Array.from(xs.map((x, i) => (Math.sin(x * 12.9898 + ys[i]! * 78.233) * 43758.5453) % 1).map(Math.abs));
      // Some plankton are much more sensitive than others, so the glow scatters.
      sens = Float32Array.from(tint, (v, i) => {
        const r = Math.abs((Math.sin(i * 3.7 + v * 91.3) * 12345.678) % 1);
        return 0.15 + 0.85 * r * r;
      });
      paint();
      ox = new Float32Array(n);
      oy = new Float32Array(n);
      vx = new Float32Array(n);
      vy = new Float32Array(n);
      glow = new Float32Array(n);

      if (!p.placed) {
        const s = shape();
        p.x = p.tx = W * s.wx;
        p.y = p.ty = H * s.wy;
      }
    }

    function paint() {
      halo = new Array(n);
      core = new Array(n);
      for (let i = 0; i < n; i++) {
        const tt = tint[i]!;
        const col = light
          ? mix(GLOW_A_LIGHT, GLOW_C_LIGHT, tt)
          : tt < 0.5
            ? mix(GLOW_A, GLOW_B, tt * 2)
            : mix(GLOW_B, GLOW_C, (tt - 0.5) * 2);
        halo[i] = `rgb(${col.join(',')})`;
        core[i] = light ? halo[i]! : `rgb(${mix(col, [235, 255, 255], 0.3).join(',')})`;
      }
    }

    function draw(now: number) {
      const t = still ? 0 : (now - start) / 1000;
      // Frame length relative to 60fps, so the idle (slower) frames behave the same.
      const dt = still ? 1 : clamp((now - last) / 16.7, 0.5, 4);
      last = now;

      // Resting, gone or no mouse: the light wanders slowly in the top-right.
      const wandering = !finePointer || !p.inside || now - p.lastMove > 2600;
      if (wandering) {
        const s = shape();
        p.tx = W * (s.wx + s.ax * Math.sin(t * 0.21));
        p.ty = H * (s.wy + s.ay * Math.sin(t * 0.29 + 1.3));
      }
      const px0 = p.x;
      const py0 = p.y;
      const ease = 1 - Math.pow(1 - 0.1, dt);
      p.x += (p.tx - p.x) * ease;
      p.y += (p.ty - p.y) * ease;
      const mvx = (p.x - px0) / dt;
      const mvy = (p.y - py0) / dt;
      const speed = Math.hypot(mvx, mvy);

      // How strongly the light shows here: full in the top-right, dimming
      // smoothly towards the headline. A wandering light stays gentle.
      const here = smooth(clamp(focus(p.x, p.y) * 1.8));
      const targetLevel = (wandering ? 0.55 : 1) * here;
      p.level += (targetLevel - p.level) * (1 - Math.pow(1 - 0.06, dt));

      ctx!.clearRect(0, 0, W, H);

      // The warm light (dark mode). Light mode keeps a clean white page.
      if (!light && p.level > 0.01) {
        const R = 260;
        ctx!.globalAlpha = p.level;
        ctx!.drawImage(lightImg, p.x - R, p.y - R, R * 2, R * 2);
      }

      const reach = 130;
      const stir = clamp(speed / 14) * p.level; // only movement stirs the water
      const springK = 0.012 * dt;
      const damp = Math.pow(0.9, dt);
      const fade = Math.pow(0.968, dt);
      const ink = light ? INK_LIGHT : INK_DARK;
      const resting: Path2D[] = Array.from({ length: BUCKETS }, () => new Path2D());
      const glowing: number[] = [];

      for (let i = 0; i < n; i++) {
        const w = pres[i]!;
        const wave = Math.sin(t * 0.8 + phase[i]!);
        const hx = bx[i]!;
        const hy = by[i]! + wave * 2;

        // Stirred by the cursor: dragged along with its movement, nudged
        // outwards, and lit up.
        const dx = hx + ox[i]! - p.x;
        const dy = hy + oy[i]! - p.y;
        const dist = Math.hypot(dx, dy) || 1;
        if (stir > 0.002 && dist < reach) {
          const k = (1 - dist / reach) ** 2 * stir;
          vx[i]! += (mvx * 0.08 + (dx / dist) * 0.45) * k * dt;
          vy[i]! += (mvy * 0.08 + (dy / dist) * 0.45) * k * dt;
          glow[i] = Math.min(1, glow[i]! + k * 0.7 * sens[i]! * dt);
        }
        // Water: drifts, slows down, and settles back home.
        vx[i] = (vx[i]! - ox[i]! * springK) * damp;
        vy[i] = (vy[i]! - oy[i]! * springK) * damp;
        ox[i]! += vx[i]! * dt;
        oy[i]! += vy[i]! * dt;
        glow[i]! *= fade;

        const x = hx + ox[i]!;
        const y = hy + oy[i]!;
        let alpha = w * (0.2 + 0.14 * (wave + 1) * 0.5);
        if (light) alpha *= 0.8;
        if (glow[i]! > 0.04) {
          glowing.push(i, x, y);
          continue;
        }
        if (alpha < 0.012) continue;
        alpha = Math.min(alpha, MAX_ALPHA);
        const r = 0.85 + w * 0.45;
        const b = Math.min(BUCKETS - 1, Math.floor((alpha / MAX_ALPHA) * BUCKETS));
        resting[b]!.moveTo(x + r, y);
        resting[b]!.arc(x, y, r, 0, TAU);
      }

      // Resting dots: one fill per brightness step instead of one per dot.
      ctx!.fillStyle = `rgb(${ink.join(',')})`;
      resting.forEach((path, b) => {
        ctx!.globalAlpha = ((b + 0.5) / BUCKETS) * MAX_ALPHA;
        ctx!.fill(path);
      });

      // Glowing plankton: a soft halo plus a brighter core, added as light.
      if (glowing.length) {
        if (!light) ctx!.globalCompositeOperation = 'lighter';
        for (let j = 0; j < glowing.length; j += 3) {
          const i = glowing[j]!;
          const x = glowing[j + 1]!;
          const y = glowing[j + 2]!;
          // A faint twinkle while glowing.
          const g = glow[i]! * (0.85 + 0.15 * Math.sin(t * 7 + phase[i]! * 5));
          const w = Math.max(0.35, pres[i]!);
          const r = 0.9 + w * 0.45 + g * 1.4;
          // halo
          ctx!.globalAlpha = g * w * (light ? 0.1 : 0.18);
          ctx!.fillStyle = halo[i]!;
          ctx!.beginPath();
          ctx!.arc(x, y, r * 3, 0, TAU);
          ctx!.fill();
          // core: a little whiter than the halo (dark mode)
          ctx!.globalAlpha = Math.min(MAX_ALPHA, 0.25 + g * w * 0.75);
          ctx!.fillStyle = core[i]!;
          ctx!.beginPath();
          ctx!.arc(x, y, r, 0, TAU);
          ctx!.fill();
        }
        ctx!.globalCompositeOperation = 'source-over';
      }
      ctx!.globalAlpha = 1;
    }

    function loop(now: number) {
      raf = requestAnimationFrame(loop);
      // The slow idle drift (and touch screens) only needs a third of the frame rate,
      // unless dots are still glowing and settling.
      const idle = !finePointer || !p.inside || now - p.lastMove > 2600;
      if (idle && now - p.lastMove > 4000 && frameNo++ % 3) return;
      draw(now);
    }

    function play() {
      if (still || running || !onScreen || document.hidden) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    }

    function pause() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function onPointerMove(event: PointerEvent) {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      const rect = root!.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      p.inside = y > -40 && y < rect.height + 40 && x > -rect.width;
      if (!p.inside) return;
      // The light keeps following anywhere over the hero; its strength
      // (in draw) fades it out as it leaves the top-right.
      p.tx = x;
      p.ty = y;
      p.lastMove = performance.now();
      p.placed = true;
    }

    const onLeave = () => (p.inside = false);
    const onVisibility = () => (document.hidden ? pause() : play());
    const resize = new ResizeObserver(() => {
      layout();
      if (still) draw(performance.now());
    });
    const io = new IntersectionObserver(([entry]) => {
      onScreen = !!entry?.isIntersecting;
      onScreen ? play() : pause();
    });
    const themeWatch = new MutationObserver(() => {
      light = html.dataset.theme === 'light';
      paint();
      if (still) draw(performance.now());
    });

    layout();
    draw(performance.now());
    resize.observe(root);
    io.observe(root);
    themeWatch.observe(html, { attributes: true, attributeFilter: ['data-theme'] });
    document.addEventListener('visibilitychange', onVisibility);
    document.documentElement.addEventListener('mouseleave', onLeave);
    if (!still) window.addEventListener('pointermove', onPointerMove, { passive: true });
    play();

    teardown = () => {
      pause();
      resize.disconnect();
      io.disconnect();
      themeWatch.disconnect();
      document.removeEventListener('visibilitychange', onVisibility);
      document.documentElement.removeEventListener('mouseleave', onLeave);
      window.removeEventListener('pointermove', onPointerMove);
      teardown = null;
    };
  }

  document.addEventListener('astro:page-load', initField);
  document.addEventListener('astro:before-swap', () => teardown?.());
</script>

<style>
  .field {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 66%;
    z-index: 0;
    pointer-events: none;
    /* Soft edges: fades in from the left and out at the bottom */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 22%),
      linear-gradient(to bottom, #000 70%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 22%),
      linear-gradient(to bottom, #000 70%, transparent);
    mask-composite: intersect;
  }

  .field__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 759px) {
    .field {
      width: 100%;
      -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
      mask-image: linear-gradient(to bottom, #000 70%, transparent);
    }
  }
</style>
