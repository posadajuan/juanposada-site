---
import { site } from '@/data/site';

const year = new Date().getFullYear();
const socials = site.socials.filter((s) => s.href);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {year} {site.name} · {site.location}</p>
    <ul role="list" class="site-footer__links">
      {
        socials.map((s) => (
          <li>
            <a class="link" href={s.href} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a class="link" href="#main">Back to top ↑</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-l);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 0;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
