---
/**
 * Grid of logos or graphic pieces. Each tile opens the lightbox.
 * Logos sit centred on a neutral square tile; graphic pieces fill
 * a portrait tile.
 */
import { getImage, Picture } from 'astro:assets';
import Lightbox from '@/components/Lightbox.astro';
import type { Gallery } from '@/lib/content';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { kind, items, title } = gallery.data;
const group = `gallery-${gallery.id}`;

const large = await Promise.all(
  items.map((item) => getImage({ src: item.image, width: Math.min(2000, item.image.width), format: 'webp' })),
);
---

<ul role="list" class:list={['ggrid', `ggrid--${kind}`]}>
  {
    items.map((item, i) => (
      <li data-reveal>
        <a
          class="ggrid__item"
          href={large[i]?.src}
          data-lightbox={group}
          data-astro-prefetch="false"
          data-index={i}
          data-alt={item.alt}
          data-title={[item.title, item.year].filter(Boolean).join(' · ')}
          data-caption={item.caption ?? ''}
        >
          <div class="ggrid__tile">
            <Picture
              src={item.image}
              alt={item.alt}
              widths={[400, 800].filter((w) => w <= item.image.width)}
              sizes="(min-width: 1240px) 280px, (min-width: 761px) 25vw, 50vw"
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="ggrid__caption">
            <span class="ggrid__title">{item.title}</span>
            {item.year && <span class="label muted">{item.year}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<Lightbox group={group} label={title} />

<style>
  .ggrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
  }

  .ggrid--graphics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ggrid__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .ggrid__tile {
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--dur-fast) ease;
  }

  .ggrid--graphics .ggrid__tile {
    aspect-ratio: 4 / 5;
  }

  .ggrid__tile :global(picture),
  .ggrid__tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ggrid__tile :global(img) {
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  /* Logos are square images with their own background: they fill the tile. */

  .ggrid__item:hover .ggrid__tile {
    border-color: var(--color-border-strong);
  }

  .ggrid__item:hover .ggrid__tile :global(img) {
    transform: scale(1.04);
  }

  .ggrid__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .ggrid__title {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 760px) {
    .ggrid,
    .ggrid--graphics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>
