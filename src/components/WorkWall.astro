---
/**
 * "The Wall": a slow, endless drift of real work under the Home hero.
 *
 * It builds itself from your content: project covers, key screens and
 * showcase images from every public case study, plus your logos. Add a
 * project and it joins the wall automatically. Galleries still holding
 * placeholder text (alt starting with "[") are left out.
 *
 * Tiles are small WebP files only (no AVIF) to keep builds quick.
 * Hovering slows it down; it pauses when off screen; visitors who prefer
 * less motion see a still, tilted mosaic.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getGalleries, getPublicProjects } from '@/lib/content';

const ROWS = 4;

type Tile = { src: ImageMetadata; kind: 'screen' | 'logo' };

const projects = await getPublicProjects();
const screens: Tile[] = [];
for (const p of projects) {
  const d = p.data;
  const imgs = [
    d.cover,
    d.problem?.image,
    ...(d.solution?.decisions ?? []).map((x) => x.image),
    d.solution?.showcase,
  ].filter((x): x is ImageMetadata => !!x);
  for (const src of imgs) {
    const ratio = src.width / src.height;
    // Very tall or very wide images read poorly at tile size.
    if (ratio >= 0.7 && ratio <= 2.4) screens.push({ src, kind: 'screen' });
  }
}

const logos: Tile[] = (await getGalleries('logos'))
  .flatMap((g) => g.data.items)
  .filter((item) => !item.alt.startsWith('['))
  .map((item) => ({ src: item.image, kind: 'logo' as const }));

// Interleave: two screens, then a logo, so every row mixes both.
const mixed: Tile[] = [];
let s = 0;
let l = 0;
while (s < screens.length || l < logos.length) {
  for (let k = 0; k < 2 && s < screens.length; k++) mixed.push(screens[s++]!);
  if (l < logos.length) mixed.push(logos[l++]!);
}

const rows: Tile[][] = Array.from({ length: ROWS }, () => []);
mixed.forEach((tile, i) => rows[i % ROWS]!.push(tile));
---

<div
  class="wall"
  data-wall
  role="img"
  aria-label="A slowly drifting wall of my work: screens from Cyber Explorers, Lloyd's Register, Cloud Academy and Fujitsu & NatWest, mixed with logos I've designed."
>
  <div class="wall__plane" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class:list={['wall__row', { 'wall__row--reverse': r % 2 === 1 }]} style={`--speed: ${70 + r * 12}s`}>
          <div class="wall__track">
            {[0, 1].map((copy) =>
              row.map((tile) => (
                <div class:list={['wall__tile', `wall__tile--${tile.kind}`]} style={`aspect-ratio: ${tile.src.width} / ${tile.src.height}`}>
                  <Picture
                    src={tile.src}
                    alt=""
                    widths={[320, 560].filter((w) => w <= tile.src.width)}
                    sizes="(min-width: 761px) 320px, 200px"
                    formats={['webp']}
                    loading={r < 2 && copy === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  function initWall() {
    document.querySelectorAll<HTMLElement>('[data-wall]').forEach((el) => {
      if (el.dataset.wallReady) return;
      el.dataset.wallReady = '1';
      // Only move while on screen.
      new IntersectionObserver(([entry]) => el.toggleAttribute('data-play', !!entry?.isIntersecting)).observe(el);
      // Hover eases it down to a crawl, so people can look.
      const setRate = (rate: number) => el.getAnimations({ subtree: true }).forEach((a) => (a.playbackRate = rate));
      el.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && setRate(0.25));
      el.addEventListener('pointerleave', () => setRate(1));
    });
  }
  document.addEventListener('astro:page-load', initWall);
</script>

<style>
  .wall {
    --gap: clamp(10px, 1.2vw, 18px);
    position: relative;
    height: clamp(380px, 46vw, 620px);
    border-radius: var(--radius-l);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  /* A larger, tilted plane so the rows reach every corner. */
  .wall__plane {
    position: absolute;
    inset: -22% -12%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--gap);
    transform: rotate(-7deg);
  }

  .wall__row {
    flex: 1;
    min-height: 0;
    overflow: visible;
  }

  .wall__track {
    display: flex;
    height: 100%;
    width: max-content;
  }

  /* Still mosaic: offset rows a little so it doesn't look like a grid. */
  .wall__row:nth-child(2) .wall__track { transform: translateX(-12%); }
  .wall__row:nth-child(3) .wall__track { transform: translateX(-4%); }
  .wall__row:nth-child(4) .wall__track { transform: translateX(-18%); }

  .wall__tile {
    height: 100%;
    margin-right: var(--gap);
    flex: none;
    border-radius: var(--radius-m);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-media);
  }

  .wall__tile :global(picture),
  .wall__tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Moving (only when the visitor hasn't asked for less motion) */
  :global([data-motion]) .wall__track {
    animation: wall-drift var(--speed) linear infinite;
  }
  :global([data-motion]) .wall__row--reverse .wall__track {
    animation-direction: reverse;
  }
  .wall:not([data-play]) .wall__track {
    animation-play-state: paused;
  }

  @keyframes wall-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 760px) {
    .wall {
      height: clamp(320px, 92vw, 440px);
    }
    .wall__plane {
      inset: -18% -40%;
    }
  }
</style>
