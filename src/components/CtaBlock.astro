---
import { site } from '@/data/site';
import CopyEmailButton from '@/components/CopyEmailButton.astro';

interface Props {
  /** Text before the gradient word */
  before?: string;
  /** The gradient word(s) */
  highlight?: string;
  /** Text after the gradient word */
  after?: string;
}

const { before = 'Have a', highlight = 'project', after = 'in mind?' } = Astro.props;
---

<!-- Always dark, in both modes, so the page ends on a strong note -->
<section class="container cta-wrap" aria-labelledby="cta-title">
  <div class="cta" data-theme="dark">
    {site.availability.show && <p class="label muted">{site.availability.text}</p>}
    <h2 id="cta-title" class="cta__title">
      {before} <span class="gradient-text">{highlight}</span> {after}
    </h2>
    <p class="cta__text">Tell me a little about it. I reply within {site.replyTime}.</p>
    <div class="cta__actions">
      <a href="/contact" class="btn btn--primary">Start a conversation</a>
      <CopyEmailButton />
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block-end: 96px;
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(56px, 4rem + 3vw, 96px) clamp(24px, 1rem + 4vw, 64px);
    border-radius: var(--radius-xl);
    background: var(--color-cta-bg);
    color: var(--color-text);
  }

  /* In light mode the block is black, not dark grey */
  :global([data-theme='light']) .cta {
    background: #0a0a0a;
  }

  .cta__title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-hero);
    line-height: 1.02;
    max-width: 14ch;
    text-wrap: balance;
  }

  .cta__text {
    max-width: 560px;
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
