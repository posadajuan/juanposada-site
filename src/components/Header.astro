---
import { site, nav } from '@/data/site';
import Logo from '@/components/Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <nav class="container site-header__inner" aria-label="Main">
    <a href="/" class="site-header__name">
      <Logo size={26} class="site-header__logo" />
      <span>{site.name}</span>
    </a>

    <div class="site-header__menu" id="site-menu" data-menu>
      <ul role="list" class="site-header__links">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-header__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-header__actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to light mode">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <button
        class="menu-btn"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        Menu
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    height: var(--nav-height);
  }

  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-header__logo {
    flex-shrink: 0;
    transition: transform 400ms var(--ease);
  }

  .site-header__name:hover .site-header__logo {
    transform: rotate(-8deg);
  }

  .site-header__menu {
    margin-left: auto;
  }

  .site-header__links {
    display: flex;
    gap: 36px;
    margin: 0;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-small);
    text-decoration: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .site-header__link:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .site-header__link[aria-current='page'] {
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent-line);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .icon-btn:hover {
    border-color: var(--color-border-strong);
  }

  /* Show the icon for the mode you'd switch TO */
  .icon-moon { display: none; }
  :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }

  .menu-btn {
    display: none;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: transparent;
    font-size: var(--text-small);
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
    }

    /*
     * The panel hangs from the bottom of the header and fills the rest of
     * the screen with a solid background. (position: fixed doesn't work
     * here: the header's blur effect would shrink it to the header's size.)
     */
    .site-header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--nav-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0;
      padding: var(--space-l) var(--gutter) calc(var(--space-xl) + env(safe-area-inset-bottom));
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 300ms var(--ease),
        transform 300ms var(--ease),
        visibility 0s linear 300ms;
    }

    .site-header__menu[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 300ms var(--ease),
        transform 300ms var(--ease);
    }

    /* While the menu is open, the bar turns solid so bar + panel read as one sheet */
    .site-header:has([data-menu][data-open]) {
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header__links {
      flex-direction: column;
      gap: 4px;
    }

    .site-header__links li {
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__link {
      width: 100%;
      padding-block: 10px;
    }

    .site-header__link {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: var(--weight-semibold);
      letter-spacing: -0.02em;
      min-height: 56px;
    }
  }
</style>

<script>
  // Registered once; uses event delegation so it keeps working after
  // page transitions swap the header.
  function syncToggleLabel() {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;
    const isLight = document.documentElement.dataset.theme === 'light';
    btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
  }

  function closeMenu() {
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    menu?.removeAttribute('data-open');
    document.documentElement.style.overflow = '';
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = 'Menu';
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('[data-theme-toggle]')) {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'light' ? '#ffffff' : '#0a0a0a');
      syncToggleLabel();
      return;
    }

    const menuToggle = target.closest<HTMLButtonElement>('[data-menu-toggle]');
    if (menuToggle) {
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.textContent = open ? 'Close' : 'Menu';
      menu?.toggleAttribute('data-open', open);
      // Stop the page underneath from scrolling while the menu is open.
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) document.documentElement.removeAttribute('data-nav-hidden');
      return;
    }

    if (target.closest('[data-menu] a')) closeMenu();
  });

  document.addEventListener('astro:before-swap', closeMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  document.addEventListener('astro:page-load', syncToggleLabel);
</script>
