---
import { site, nav } from '@/data/site';
import Logo from '@/components/Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <nav class="container site-header__inner" aria-label="Main">
    <a href="/" class="site-header__name">
      <Logo size={26} class="site-header__logo" />
      <span class="site-header__wordmark">
        <span class="site-header__first">{site.name.split(' ')[0]}</span>{' '}
        <span class="site-header__last">{site.name.split(' ').slice(1).join(' ')}</span>
      </span>
    </a>

    <div class="site-header__menu" id="site-menu" data-menu>
      <ul role="list" class="site-header__links">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-header__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-header__actions">
      <button class="theme-switch" type="button" role="switch" aria-checked="true" aria-label="Dark mode" data-theme-toggle>
        <span class="theme-switch__label"><span class="theme-switch__long">Dark mode</span><span class="theme-switch__short" aria-hidden="true">Dark</span></span>
        <span class="theme-switch__track" aria-hidden="true"><span class="theme-switch__thumb"></span></span>
      </button>
      <button
        class="menu-btn"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        Menu
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    height: var(--nav-height);
  }

  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.25rem; /* 5% up from 1.1875rem */
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Small phones: keep the name on one line beside the switch and menu */
  @media (max-width: 420px) {
    .site-header__inner {
      gap: 12px;
    }
    .site-header__name {
      gap: 8px;
      font-size: 1.05rem;
    }
  }

  /* "Juan" light, "Posada" bold */
  .site-header__first {
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .site-header__logo {
    flex-shrink: 0;
    transition: transform 400ms var(--ease);
  }

  .site-header__name:hover .site-header__logo {
    transform: rotate(-8deg);
  }

  .site-header__menu {
    margin-left: auto;
  }

  .site-header__links {
    display: flex;
    gap: 36px;
    margin: 0;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-small);
    text-decoration: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .site-header__link:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .site-header__link[aria-current='page'] {
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent-line);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .icon-btn:hover {
    border-color: var(--color-border-strong);
  }

  /* Dark mode switch: a labelled on/off toggle. Its look follows the
     theme on <html>, so it is right before any script runs. */
  .theme-switch {
    display: inline-flex;
    align-items: center;
    /* 20% smaller than the nav buttons, so it sits quietly beside them */
    gap: 8px;
    min-height: 35px;
    padding: 0 5px 0 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: calc(var(--text-small) * 0.85);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .theme-switch:hover {
    border-color: var(--color-border-strong);
  }

  .theme-switch__short {
    display: none;
  }

  .theme-switch__track {
    position: relative;
    width: 35px;
    height: 21px;
    border-radius: var(--radius-pill);
    background: var(--gradient-a);
    transition: background var(--dur-fast) ease;
  }

  .theme-switch__thumb {
    position: absolute;
    top: 2.5px;
    left: 2.5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #0a0a0a;
    transform: translateX(14px);
    transition: transform 250ms var(--ease);
  }

  :global([data-theme='light']) .theme-switch__track {
    background: #d6d6d3;
  }

  :global([data-theme='light']) .theme-switch__thumb {
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch__thumb {
      transition: none;
    }
  }

  @media (max-width: 420px) {
    .theme-switch__long {
      display: none;
    }
    .theme-switch__short {
      display: inline;
    }
  }

  .menu-btn {
    display: none;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: transparent;
    font-size: var(--text-small);
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
    }

    /*
     * The panel hangs from the bottom of the header and fills the rest of
     * the screen with a solid background. (position: fixed doesn't work
     * here: the header's blur effect would shrink it to the header's size.)
     */
    .site-header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--nav-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0;
      padding: var(--space-l) var(--gutter) calc(var(--space-xl) + env(safe-area-inset-bottom));
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 300ms var(--ease),
        transform 300ms var(--ease),
        visibility 0s linear 300ms;
    }

    .site-header__menu[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 300ms var(--ease),
        transform 300ms var(--ease);
    }

    /* While the menu is open, the bar turns solid so bar + panel read as one sheet */
    .site-header:has([data-menu][data-open]) {
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header__links {
      flex-direction: column;
      gap: 4px;
    }

    .site-header__links li {
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__link {
      width: 100%;
      padding-block: 10px;
    }

    .site-header__link {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: var(--weight-semibold);
      letter-spacing: -0.02em;
      min-height: 56px;
    }
  }
</style>

<script>
  // Registered once; uses event delegation so it keeps working after
  // page transitions swap the header.
  function syncToggleLabel() {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;
    const isLight = document.documentElement.dataset.theme === 'light';
    btn.setAttribute('aria-checked', isLight ? 'false' : 'true');
  }

  /* While the mobile menu is open, the page behind it can't be reached with
     Tab or a screen reader (inert), so keyboard focus stays in the header. */
  function setPageInert(on: boolean) {
    document.querySelectorAll<HTMLElement>('main, footer, .skip-link').forEach((el) => (el.inert = on));
  }

  function closeMenu({ refocus = false } = {}) {
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const wasOpen = menu?.hasAttribute('data-open');
    menu?.removeAttribute('data-open');
    document.documentElement.style.overflow = '';
    setPageInert(false);
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = 'Menu';
      if (wasOpen && refocus) toggle.focus();
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('[data-theme-toggle]')) {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'light' ? '#ffffff' : '#0a0a0a');
      syncToggleLabel();
      return;
    }

    const menuToggle = target.closest<HTMLButtonElement>('[data-menu-toggle]');
    if (menuToggle) {
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.textContent = open ? 'Close' : 'Menu';
      menu?.toggleAttribute('data-open', open);
      // Stop the page underneath from scrolling while the menu is open.
      document.documentElement.style.overflow = open ? 'hidden' : '';
      setPageInert(open);
      if (open) {
        document.documentElement.removeAttribute('data-nav-hidden');
        // Move focus to the first link so keyboard users land in the menu.
        menu?.querySelector<HTMLElement>('a')?.focus();
      }
      return;
    }

    if (target.closest('[data-menu] a')) closeMenu();
  });

  document.addEventListener('astro:before-swap', () => closeMenu());

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu({ refocus: true });
  });

  document.addEventListener('astro:page-load', syncToggleLabel);
</script>
