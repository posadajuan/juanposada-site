---
import '@fontsource-variable/roboto';
import '@fontsource-variable/roboto-flex';
import '@/styles/global.css';
import '@/styles/motion.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { ImageMetadata } from 'astro';
import { site } from '@/data/site';
import { canonicalPath, personSchema, socialImage, SOCIAL_IMAGE, websiteSchema } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image: an imported image (cropped to 1200×630 for you) or a path in /public. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** 'article' for case studies, 'profile' for About, otherwise 'website'. */
  type?: 'website' | 'article' | 'profile';
  /** Extra structured data for this page (schema.org objects). */
  schema?: Record<string, unknown>[];
  /** Keep this page out of search engines. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  imageAlt = `${site.name}: ${site.description}`,
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role} in London`;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const imagePath = typeof image === 'string' ? image : await socialImage(image);
const ogImage = new URL(imagePath, Astro.site);

// Structured data: the site and Juan on every page, plus anything page-specific.
const jsonLd = noindex
  ? null
  : JSON.stringify({ '@context': 'https://schema.org', '@graph': [websiteSchema(), await personSchema(), ...schema] }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!--
      Set the theme before the page paints, so there is never a flash
      of the wrong colours. Order: visitor's saved choice → device setting
      (when defaultTheme is 'system') → site default.
    -->
    <script is:inline define:vars={{ defaultTheme: site.defaultTheme }}>
      (function () {
        var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
        function saved() {
          try {
            var t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') return t;
          } catch (e) {}
          return null;
        }
        function pick() {
          var t = saved();
          if (t) return t;
          if (defaultTheme === 'system') return darkQuery.matches ? 'dark' : 'light';
          return defaultTheme;
        }
        function apply(doc) {
          var theme = pick();
          doc.documentElement.dataset.theme = theme;
          // Motion only for visitors who haven't asked to reduce it.
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            doc.documentElement.setAttribute('data-motion', '');
          }
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#0a0a0a');
        }
        apply(document);
        // Keep the theme when moving between pages with view transitions.
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument);
        });
        // Follow the device live (e.g. automatic dark mode at sunset), unless
        // the visitor has picked a mode themselves.
        if (defaultTheme === 'system') {
          darkQuery.addEventListener('change', function () {
            if (saved()) return;
            apply(document);
            document.dispatchEvent(new Event('themechange'));
          });
        }
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
