---
import '@fontsource-variable/roboto';
import '@fontsource-variable/roboto-flex';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/og-default.png' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />

    <!--
      Set the theme before the page paints, so there is never a flash
      of the wrong colours. Order: visitor's saved choice → site default.
    -->
    <script is:inline define:vars={{ defaultTheme: site.defaultTheme }}>
      (function () {
        function pick() {
          try {
            var saved = localStorage.getItem('theme');
            if (saved === 'light' || saved === 'dark') return saved;
          } catch (e) {}
          if (defaultTheme === 'system') {
            return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          return 'dark';
        }
        function apply(doc) {
          var theme = pick();
          doc.documentElement.dataset.theme = theme;
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#0a0a0a');
        }
        apply(document);
        // Keep the theme when moving between pages with view transitions.
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument);
        });
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
