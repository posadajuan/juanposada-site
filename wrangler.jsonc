{
  // Cloudflare deployment settings.
  // The site is static: Cloudflare serves the built files from ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juanposada-site",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Lets every branch / pull request get its own preview link.
  "previews": {}
}
